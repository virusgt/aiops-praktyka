{
  "id": null,
  "uid": null,
  "title": "Kantyna — AIOps Observability",
  "description": "Lab05 — orders-api, worker i pamięć w namespace demo. Anomalie A1–A3: labs/lab05-observability/momenty.md",
  "tags": ["kantyna", "aiops", "lab05", "demo"],
  "timezone": "Europe/Warsaw",
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-4d", "to": "now" },
  "refresh": "",
  "timepicker": { "refresh_intervals": ["30s", "1m", "5m", "15m"] },
  "templating": { "list": [] },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [],
  "schemaVersion": 41,
  "version": 0,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Błędy HTTP 5xx orders-api [%]",
      "description": "Udział odpowiedzi 5xx we wszystkich odpowiedziach orders-api (z sondami i /metrics). Luka = brak szeregu 5xx (BRAK DANYCH), nie 0 %.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": { "mode": "none", "group": "A" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum(rate(http_requests_total{namespace=\"demo\", job=\"kantyna-orders-api\", status=~\"5..\"}[$__rate_interval])) / sum(rate(http_requests_total{namespace=\"demo\", job=\"kantyna-orders-api\"}[$__rate_interval]))",
          "legendFormat": "5xx %",
          "range": true, "instant": false, "editorMode": "code"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 POST /api/orders [s]",
      "description": "Estymacja z histogramu (kubełki 0.025/0.05/0.1/0.25/0.5/1/2.5/5/10 s), nie pomiar pojedynczego żądania.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": { "mode": "none", "group": "A" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"demo\", job=\"kantyna-orders-api\", method=\"POST\", route=\"/api/orders\"}[$__rate_interval])))",
          "legendFormat": "p95 POST /api/orders",
          "range": true, "instant": false, "editorMode": "code"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Ruch HTTP orders-api wg method i route [req/s]",
      "description": "Bez filtra route — zawiera route=\"unmatched\" (tam trafiały błędy 5xx z A1) oraz sondy /healthz, /readyz i /metrics.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": { "mode": "none", "group": "A" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (method, route) (rate(http_requests_total{namespace=\"demo\", job=\"kantyna-orders-api\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{route}}",
          "range": true, "instant": false, "editorMode": "code"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Kolejka workera — widoczne wiadomości",
      "description": "ApproximateNumberOfMessages z SQS (wartość przybliżona), maksimum w przedziale kroku; nie obejmuje wiadomości w przetwarzaniu ani DLQ.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": { "mode": "none", "group": "A" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(max_over_time(worker_queue_visible_messages{namespace=\"demo\", job=\"kantyna-worker\"}[$__rate_interval]))",
          "legendFormat": "widoczne wiadomości (przybl.)",
          "range": true, "instant": false, "editorMode": "code"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pamięć orders-api wg poda [MiB]",
      "description": "container_memory_working_set_bytes (maksimum w przedziale kroku) na tle limitu pamięci kontenera.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "fieldConfig": {
        "defaults": {
          "unit": "mbytes",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": { "mode": "none", "group": "A" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              { "id": "displayName", "value": "limit" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.lineWidth", "value": 2 }
            ]
          }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (pod) (max_over_time(container_memory_working_set_bytes{namespace=\"demo\", container=\"orders-api\"}[$__rate_interval])) / 1024 / 1024",
          "legendFormat": "{{pod}}",
          "range": true, "instant": false, "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(kube_pod_container_resource_limits{namespace=\"demo\", container=\"orders-api\", resource=\"memory\"}) / 1024 / 1024",
          "legendFormat": "limit",
          "range": true, "instant": false, "editorMode": "code"
        }
      ]
    }
  ]
}
